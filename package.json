{
  "name": "arth",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "mobile": "pnpm --filter @arth/mobile start",
    "mobile:android": "pnpm --filter @arth/mobile android",
    "mobile:typecheck": "pnpm --filter @arth/mobile typecheck",
    "mobile:lint": "pnpm --filter @arth/mobile lint",
    "mobile:bundle:android": "pnpm --filter @arth/mobile bundle:android",
    "verify:mobile": "pnpm mobile:typecheck && pnpm mobile:lint && pnpm mobile:bundle:android",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "gen:api": "pnpm --filter @arth/api-client gen",
    "check:money": "pnpm --filter @arth/api-client check:money",
    "dev:db": "docker compose up -d db",
    "dev:api": "go -C apps/api run ./cmd/api migrate up && go -C apps/api run ./cmd/api",
    "dev:seed": "node scripts/dev-seed.mjs",
    "dev:mobile": "pnpm --filter @arth/mobile start"
  }
}
