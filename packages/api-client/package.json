{
  "name": "@arth/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed client for the Arth API, generated from api/openapi.yaml (openapi-typescript + openapi-fetch), plus money helpers.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./money": "./src/money.ts",
    "./session": "./src/session.ts"
  },
  "scripts": {
    "gen": "openapi-typescript ../../api/openapi.yaml -o src/schema.ts",
    "check:money": "node scripts/check-money.mts",
    "typecheck": "tsc --noEmit -p .",
    "live-check": "node scripts/live-check.mts"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
