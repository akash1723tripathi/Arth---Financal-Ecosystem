# apps/mobile/.env: names only, never commit real values.
# Everything prefixed EXPO_PUBLIC_ is compiled into the app bundle and is PUBLIC. Never put a secret here.

# Base URL of the Arth Go API (no trailing slash). Optional: when empty the app uses
#   Android emulator: http://10.0.2.2:8080   iOS simulator / web: http://localhost:8080
# Physical phone on the same Wi-Fi: http://<PC LAN IP>:8080 (docs/PREVIEW_LOCALLY.md). Plain HTTP is for local dev only.
EXPO_PUBLIC_API_URL=

# Public privacy policy page (optional until it is published; the Profile row shows a placeholder when empty)
EXPO_PUBLIC_PRIVACY_POLICY_URL=

# TEMPORARY during the repoint (deleted in the last step): api (default) | supabase
EXPO_PUBLIC_BACKEND=

# ── Legacy Welth stack, only read when EXPO_PUBLIC_BACKEND=supabase (TO BE REMOVED) ──
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
# LEGACY and unsafe: an AI key in a client bundle. To be removed; AI calls move behind the Go API.
EXPO_PUBLIC_GEMINI_API_KEY=
