# apps/api/.env: configuration for the Go API + worker. NAMES ONLY here; never commit values.
# The api/worker load ./.env at start-up (variables already set in the environment win).
# Provider-specific variables are added only once each OPEN item in docs/DECISIONS.md is decided.

# local | test | staging | production (default local: text logs). LOG_LEVEL: debug|info|warn|error (default info)
APP_ENV=
# HTTP port (default 8080)
PORT=
LOG_LEVEL=
# How long to drain in-flight requests on SIGINT/SIGTERM, Go duration (default 15s)
SHUTDOWN_TIMEOUT=

# App role connection string, postgres://... (required)
DATABASE_URL=
# Migration (DDL) role; falls back to DATABASE_URL when empty. Used by `api migrate up|down|status`.
MIGRATIONS_DATABASE_URL=
# Separate database for `go test` integration tests (never the dev database)
TEST_DATABASE_URL=

# Own auth (docs/AUTH.md). Signing key: required, at least 32 bytes (e.g. `openssl rand -base64 48`).
AUTH_ACCESS_TOKEN_SIGNING_KEY=
# Go durations. Defaults: access 15m, refresh idle 720h (30 d), absolute session 2160h (90 d)
AUTH_ACCESS_TOKEN_TTL=
AUTH_REFRESH_TOKEN_TTL=
AUTH_SESSION_MAX_AGE=

# Comma-separated web origins allowed by CORS, e.g. http://localhost:3000 (no * outside local/test)
CORS_ALLOWED_ORIGINS=
# Base URL for links in emails
APP_PUBLIC_URL=

# Provider drivers (each sits behind a Go interface). AI: fake|none (default fake). Email: log|none (default log).
# Storage: none|memory (default none).
AI_DRIVER=
EMAIL_DRIVER=
STORAGE_DRIVER=
